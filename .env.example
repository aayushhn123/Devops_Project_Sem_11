# Optional. Copy this file to ".env" to override the defaults.
# Docker Compose only reads PGPASSWORD from here; its other settings are in docker-compose.yml.
# Running "python app/server.py" without Docker uses all of these values.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=price_tracker
